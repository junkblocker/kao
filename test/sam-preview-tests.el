;;; sam-preview.el --- Preview isolation and stale-plan rejection -*- lexical-binding: t; -*-
(require 'ert)
(require 'sam-preview)

(ert-deftest sam-preview-keeps-text-hooks-output-and-history-untouched ()
  (with-temp-buffer
    (insert "foo foo") (goto-char 1)
    (let* ((sam--last-regex "prior") (calls 0)
           (before-buffers (buffer-list))
           (before-output (when (get-buffer "*sam*")
                            (with-current-buffer "*sam*" (buffer-string))))
           (after-change-functions (list (lambda (&rest _) (cl-incf calls))))
           (plan (sam-preview ",x/foo/ c/bar/\na/!/\n,p")))
      (should (equal (buffer-string) "foo foo"))
      (should (= calls 0))
      (should (equal sam--last-regex "prior"))
      (should (equal (plist-get (car (plist-get plan :snapshots)) :after) "bar! bar!"))
      (should (equal (plist-get plan :output) "bar! bar!\n"))
      (should (equal before-output (when (get-buffer "*sam*")
                                    (with-current-buffer "*sam*" (buffer-string)))))
      (should-not (cl-set-difference (buffer-list) before-buffers))
      (sam-apply-preview plan)
      (should (equal (buffer-string) "bar! bar!"))
      (should (> calls 0)))))

(ert-deftest sam-preview-rejects-nested-shell-and-undo-before-execution ()
  (with-temp-buffer
    (insert "foo") (goto-char 1)
    (cl-letf (((symbol-function 'call-process-region)
               (lambda (&rest _) (ert-fail "Preview ran a shell")))
              ((symbol-function 'sam--run-in)
               (lambda (&rest _) (ert-fail "Rejected program was evaluated"))))
      (dolist (recipe '("|cat" "<cat" ">cat" "!true" "u" ",x/foo/ |cat" "{\n,p\nu\n}"))
        (should-error (sam-preview recipe) :type 'sam-error)))
    (should (equal (buffer-string) "foo"))))

(ert-deftest sam-preview-buffer-loops-use-original-labels-and-apply ()
  (let ((a (generate-new-buffer "sam-preview-fixture-a"))
        (b (generate-new-buffer "sam-preview-fixture-b"))
        (sam--last-regex nil))
    (unwind-protect
        (with-current-buffer a
          (insert "foo") (goto-char 1)
          (with-current-buffer b (insert "foo"))
          (let ((plan (sam-preview "X/^sam-preview-fixture-/ ,x/foo/ c/bar/")))
            (should (= (length (plist-get plan :snapshots)) 2))
            (dolist (buffer (list a b))
              (should (equal (with-current-buffer buffer (buffer-string)) "foo")))
            (sam-apply-preview plan)
            (dolist (buffer (list a b))
              (should (equal (with-current-buffer buffer (buffer-string)) "bar")))))
      (kill-buffer a) (kill-buffer b))))

(ert-deftest sam-preview-file-labels-and-read-only-preflight-cover-all-targets ()
  (let ((a (generate-new-buffer "sam-preview-file-a"))
        (b (generate-new-buffer "sam-preview-file-b"))
        (sam--last-regex nil))
    (unwind-protect
        (with-current-buffer a
          (insert "foo") (goto-char 1)
          (setq buffer-file-name "/tmp/sam-preview-example/one.txt")
          (with-current-buffer b
            (insert "foo")
            (setq buffer-file-name "/tmp/sam-preview-example/two.txt"))
          (let ((plan (sam-preview "X@^/tmp/sam-preview-example/@ ,c/bar/")))
            (should (= (length (plist-get plan :snapshots)) 2))
            (with-current-buffer b (setq buffer-read-only t))
            (should-error (sam-apply-preview plan) :type 'sam-error)
            (should (equal (buffer-string) "foo"))
            (should (equal (with-current-buffer b (buffer-string)) "foo"))))
      (dolist (buffer (list a b))
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer)))))

(ert-deftest sam-preview-rejects-stale-context-before-any-edit ()
  (dolist (change '(text selection mark regex narrowing name mode syntax case-table))
    (with-temp-buffer
      (insert "foo foo") (goto-char 1)
      (let* ((sam--last-regex nil) (plan (sam-preview ",c/bar/")))
        (pcase change
          ('text (goto-char (point-max)) (insert "!"))
          ('selection (goto-char 2))
          ('mark (sam--save-mark '(2 . 3)))
          ('regex (setq sam--last-regex "another"))
          ('narrowing (narrow-to-region 2 5))
          ('name (rename-buffer " *sam-preview-renamed*" t))
          ('mode (text-mode))
          ('syntax (set-syntax-table (copy-syntax-table)) (modify-syntax-entry ?f "."))
          ('case-table (set-case-table (copy-case-table (current-case-table)))
                       (set-char-table-range (current-case-table) ?f ?x)))
        (let ((before (buffer-string)))
          (should-error (sam-apply-preview plan) :type 'sam-error)
          (should (equal before (buffer-string))))))))

(ert-deftest sam-preview-rejects-new-matching-buffer-and-read-only-target ()
  (let ((a (generate-new-buffer "sam-preview-membership-a")) b
        (sam--last-regex nil))
    (unwind-protect
        (with-current-buffer a
          (insert "foo") (goto-char 1)
          (let ((plan (sam-preview "X/^sam-preview-membership-/ ,c/bar/")))
            (setq b (generate-new-buffer "sam-preview-membership-b"))
            (should-error (sam-apply-preview plan) :type 'sam-error)
            (should (equal (buffer-string) "foo")))
          (let ((plan (sam-preview ",c/bar/")))
            (setq buffer-read-only t)
            (should-error (sam-apply-preview plan) :type 'sam-error)
            (should (equal (buffer-string) "foo"))))
      (kill-buffer a) (when b (kill-buffer b)))))

(ert-deftest sam-preview-preserves-narrowing-saved-mark-and-cleans-failed-copies ()
  (with-temp-buffer
    (insert "before foo after")
    (narrow-to-region 8 11) (goto-char 8)
    (sam--save-mark '(8 . 11))
    (let* ((sam--last-regex nil)
           (buffers (buffer-list))
           (plan (sam-preview "'c/bar/")))
      (should (equal (plist-get (car (plist-get plan :snapshots)) :after) "before bar after"))
      (should (equal (sam-preview--mark) '(8 . 11)))
      (should-error (sam-preview "#999d") :type 'sam-error)
      (should-not (cl-set-difference (buffer-list) buffers))
      (sam-apply-preview plan)
      (should (equal (buffer-string) "bar")))))

;;; sam-preview.el ends here
