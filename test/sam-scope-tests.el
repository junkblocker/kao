;;; sam-scope.el --- Sam address scope with real Kao selections -*- lexical-binding: t; -*-

;; Load Kao on load-path, then run with -l tests/sam-scope.el
;; -f ert-run-tests-batch-and-exit.  No complete user init is needed.
(require 'ert)
(require 'cl-lib)
(require 'kao)
(require 'sam)

(defmacro sam-scope-test/with (text selections &rest body)
  (declare (indent 2))
  `(save-window-excursion
     (with-temp-buffer
       (switch-to-buffer (current-buffer))
       (insert ,text)
       (goto-char (point-min))
       (buffer-enable-undo)
       (kao-mode 1)
       (kao-set-selections
        (mapcar (lambda (range) (kao-sel--new (car range) (cdr range))) ,selections))
       ,@body)))

(ert-deftest sam-scope-whole-buffer-appends-once-with-two-selections ()
  (sam-scope-test/with "foo foo" '((1 . 1) (5 . 5))
    (sam-execute ",a/!/")
    (should (equal (buffer-string) "foo foo!"))))

(ert-deftest sam-scope-whole-buffer-replacement-and-replay ()
  (sam-scope-test/with "foo foo" '((1 . 1) (5 . 5))
    (sam-execute ",x/foo/ c/bar/")
    (should (equal (buffer-string) "bar bar"))
    (should (= 2 (length (kao-get-selections))))
    ;; The previous recipe leaves two targets; explicit scope still runs once.
    (sam-execute ",x/bar/ a/!/")
    (should (equal (buffer-string) "bar! bar!"))))

(ert-deftest sam-scope-unaddressed-and-dot-commands-stay-per-selection ()
  (dolist (command '("c/X/" ".c/X/"))
    (sam-scope-test/with "foo foo" '((1 . 1) (5 . 5))
      (sam-execute command)
      (should (equal (buffer-string) "Xoo Xoo")))))

(ert-deftest sam-scope-absolute-and-anchored-addresses-run-once ()
  (dolist (case '(("2a/!/" . "a\nb\n!c\n")
                  ("#2i/!/" . "a\n!b\nc\n")
                  ("$a/!/" . "a\nb\nc\n!")
                  ("0,$a/!/" . "a\nb\nc\n!")
                  ("#0,#6a/!/" . "a\nb\nc\n!")
                  ("1+1a/!/" . "a\nb\n!c\n")
                  ("1;/b/a/!/" . "a\nb!\nc\n")
                  (".+$a/!/" . "a\nb\nc\n!")))
    (sam-scope-test/with "a\nb\nc\n" '((1 . 1) (5 . 5))
      (sam-execute (car case))
      (should (equal (buffer-string) (cdr case))))))

(ert-deftest sam-scope-mark-address-runs-once ()
  (sam-scope-test/with "a\nb\nc\n" '((1 . 1) (5 . 5))
    (sam-execute "2k")
    (sam-execute "'a/!/")
    (should (equal (buffer-string) "a\nb\n!c\n"))))

(ert-deftest sam-scope-relative-searches-and-ranges-stay-per-selection ()
  (sam-scope-test/with "a b a b" '((1 . 1) (5 . 5))
    (sam-execute "/b/c/X/")
    (should (equal (buffer-string) "a X a X")))
  (sam-scope-test/with "a b a b" '((3 . 3) (7 . 7))
    (sam-execute "?a?c/X/")
    (should (equal (buffer-string) "X b X b")))
  (dolist (command '(".,/b/c/X/" ".;/b/c/X/"))
    (sam-scope-test/with "a b a b" '((1 . 1) (5 . 5))
      (sam-execute command)
      (should (equal (buffer-string) "X X"))))
  (sam-scope-test/with "a\nb\nc\nd\n" '((1 . 1) (5 . 5))
    (sam-execute "+1i/>/")
    (should (equal (buffer-string) "a\n>b\nc\n>d\n"))))

(ert-deftest sam-scope-printing-is-not-duplicated ()
  (sam-scope-test/with "foo foo" '((1 . 1) (5 . 5))
    (should (equal (sam-execute ",p") "foo foo\n"))))

(ert-deftest sam-scope-shell-runs-once-before-changes-are-applied ()
  (sam-scope-test/with "foo foo" '((1 . 1) (5 . 5))
    (let ((calls 0) (original (symbol-function 'call-process-region)))
      (cl-letf (((symbol-function 'call-process-region)
                 (lambda (&rest args) (cl-incf calls) (apply original args))))
        (sam-execute ",|cat"))
      (should (= calls 1))
      (should (equal (buffer-string) "foo foo")))))

(ert-deftest sam-scope-nested-loops-and-unaddressed-blocks-still-repeat ()
  (dolist (command '(",x/foo/ ,a/!/" "{\n,a/!/\n}"))
    (sam-scope-test/with "foo foo" '((1 . 1) (5 . 5))
      (sam-execute command)
      (should (equal (buffer-string) "foo foo!!"))))
  (sam-scope-test/with "foo foo" '((1 . 1) (5 . 5))
    (sam-execute ",{\n,a/!/\n}")
    (should (equal (buffer-string) "foo foo!"))))

(ert-deftest sam-scope-whole-buffer-command-is-one-undo-step ()
  (sam-scope-test/with "foo foo" '((1 . 1) (5 . 5))
    ;; Drive the real command boundary and Kao's own undo/redo keys.
    ;; Calling Emacs undo directly bypasses that history and its region rules.
    (local-set-key (kbd "C-c s") #'sam)
    (execute-kbd-macro (vconcat (kbd "C-c s") ",x/foo/" (kbd "RET")))
    (should (= 2 (length (kao-get-selections))))
    (execute-kbd-macro (vconcat (kbd "C-c s") ",x/foo/ c/bar/" (kbd "RET")))
    (should (equal (buffer-string) "bar bar"))
    (execute-kbd-macro (vconcat (kbd "C-c s") ",x/bar/ a/!/" (kbd "RET")))
    (should (equal (buffer-string) "bar! bar!"))
    (execute-kbd-macro (kbd "u"))
    (should (equal (buffer-string) "bar bar"))
    (execute-kbd-macro (kbd "U"))
    (should (equal (buffer-string) "bar! bar!"))))

(ert-deftest sam-scope-whole-buffer-address-respects-narrowing ()
  (sam-scope-test/with "OUT\nfoo foo\nEND" '((5 . 5) (9 . 9))
    (save-restriction
      (narrow-to-region 5 12)
      (sam-execute ",a/!/"))
    (should (equal (buffer-string) "OUT\nfoo foo!\nEND"))))

(ert-deftest sam-scope-genuine-overlaps-still-abort ()
  (dolist (command '("/foo/c/X/" ",x/foo/ {\nc/X/\nd\n}"))
    (sam-scope-test/with "a foo b" '((1 . 1) (7 . 7))
      (should-error (sam-execute command) :type 'sam-error)
      (should (equal (buffer-string) "a foo b")))))

(ert-deftest sam-scope-mark-follows-kao-insertion-and-undo-redo ()
  (sam-scope-test/with "a\nb\nc\n" '((1 . 1))
    (local-set-key (kbd "C-c s") #'sam)
    (execute-kbd-macro (vconcat (kbd "C-c s") "2k" (kbd "RET")))
    (execute-kbd-macro (vconcat (kbd "i") "intro" (kbd "RET <escape>")))
    (should (equal (buffer-string) "intro\na\nb\nc\n"))
    (execute-kbd-macro (kbd "u"))
    (should (equal (buffer-string) "a\nb\nc\n"))
    (execute-kbd-macro (kbd "U"))
    (should (equal (buffer-string) "intro\na\nb\nc\n"))
    (execute-kbd-macro (vconcat (kbd "C-c s") "'d" (kbd "RET")))
    (should (equal (buffer-string) "intro\na\nc\n"))))

(ert-deftest sam-scope-mark-recovers-deleted-text-through-undo ()
  (sam-scope-test/with "a\nb\nc\n" '((1 . 1))
    (local-set-key (kbd "C-c s") #'sam)
    (execute-kbd-macro (vconcat (kbd "C-c s") "2k" (kbd "RET")))
    (execute-kbd-macro (vconcat (kbd "C-c s") "'d" (kbd "RET")))
    (should (equal (buffer-string) "a\nc\n"))
    (execute-kbd-macro (kbd "u"))
    (should (equal (buffer-string) "a\nb\nc\n"))
    (execute-kbd-macro (vconcat (kbd "C-c s") "'d" (kbd "RET")))
    (should (equal (buffer-string) "a\nc\n"))))

;;; sam-scope.el ends here
